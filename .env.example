# =========================
# DATABASE (Neon / PostgreSQL)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USERNAME=portfolio_user
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/portfolio?currentSchema=public

# Neon specific (Free tier max 5)
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=1

# =========================
# SECURITY
# =========================
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_ACCESS_EXPIRATION=900000
FEEDBACK_HASH_SECRET=your_feedback_hash_secret
SECURITY_TRUST_PROXY_HEADERS=false
AUTH_REFRESH_COOKIE_SECURE=false

# =========================
# TENANT & CORS
# =========================
TENANT_ROOT_DOMAINS=localhost, portfoliooss.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,https://portfoliooss.vercel.app

# =========================
# OAUTH
# =========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_OAUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/login
AUTH_OAUTH_FRONTEND_FAILURE_URL=http://localhost:3000/login

# =========================
# EMAIL (SMTP)
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Portfoliooss
MAIL_FROM_EMAIL=
SUPPORT_EMAIL=
APP_URL=http://localhost:3000

# =========================
# AI PROVIDERS
# =========================
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_SUMMARIZE_API_KEY=

# Model identifiers. Providers retire model names on their own schedule and a retired
# name answers HTTP 404, so these are configurable to make that an env change rather
# than a redeploy. Verify a Gemini name with:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" \
#     | grep -o '"name": "models/[^"]*"'
# and a Groq name with:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning-style models spend part of the completion budget before emitting content,
# so resume-sized JSON responses need more headroom than a plain chat reply.
GROQ_MAX_TOKENS=8192

SPRING_PROFILES_ACTIVE=dev

NEXT_PUBLIC_ASSET_BASE_URL=